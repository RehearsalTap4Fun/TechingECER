{
  "name": "teaching-ecer",
  "version": "0.1.0",
  "private": true,
  "description": "学前教育教研平台 · Early Childhood Education & Research",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:init": "node --experimental-strip-types scripts/init-db.mts",
